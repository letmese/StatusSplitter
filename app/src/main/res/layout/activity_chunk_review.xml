<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout_review"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:paddingHorizontal="16dp"
    android:fitsSystemWindows="false">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Review Chunks"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tv_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:padding="12dp"
        android:background="@drawable/rounded_bg"
        android:layout_marginBottom="10dp" />

    <!-- Posting Mode Selection (Full Auto PROMINENT) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Posting Mode"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:paddingBottom="6dp" />

    <RadioGroup
        android:id="@+id/rg_posting_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <!-- FULL AUTO - Prominent, first option -->
        <RadioButton
            android:id="@+id/rb_full_auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Auto unavailable — confirmation required"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#25D366"
            android:padding="8dp" />

        <!-- Guided Auto -->
        <RadioButton
            android:id="@+id/rb_guided_auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guided sharing — you choose My status and tap Send"
            android:textSize="13sp"
            android:padding="6dp" />

        <!-- Manual -->
        <RadioButton
            android:id="@+id/rb_manual_assist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manual Assist - You control everything"
            android:textSize="13sp"
            android:padding="6dp" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checkboxes select; tap Play to preview; arrows reorder"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:paddingBottom="6dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chunks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/btn_proceed_to_post"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Proceed to Post"
        android:textSize="16sp"
        android:backgroundTint="@color/green_whatsapp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp" />

</LinearLayout>