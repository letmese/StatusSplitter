<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout_setup"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true"
    android:fitsSystemWindows="false"
    android:paddingHorizontal="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Automation Setup"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Accessibility Service for Guided Auto-Post Mode"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Status Card -->
        <LinearLayout
            android:id="@+id/card_service_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/rounded_bg"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/view_status_indicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/circle_red"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tv_service_status_label"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Service: Not Enabled"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Instructions Text -->
        <TextView
            android:id="@+id/tv_setup_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.3"
            android:fontFamily="monospace"
            android:background="@drawable/rounded_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp" />

        <!-- Open Settings Button -->
        <Button
            android:id="@+id/btn_open_a11y_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Open Accessibility Settings"
            android:textSize="16sp"
            android:backgroundTint="@color/green_whatsapp"
            android:layout_marginBottom="12dp" />

        <!-- Back Button -->
        <Button
            android:id="@+id/btn_back_to_main"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Back to Main Screen"
            android:textSize="14sp"
            android:textColor="@color/green_whatsapp" />

    </LinearLayout>
</ScrollView>